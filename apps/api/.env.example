# HTTP port the API listens on (the web dev proxy expects 3001)
PORT=3001
# development | test | production
NODE_ENV=development
# Single allowed browser origin for CORS
CORS_ORIGIN=http://localhost:5173
# Local PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/marcuaiinegru
# Signs the auth JWT, at least 32 characters (required). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars
# Reverse-proxy hops in front of the API (0 = none). Set to 1 behind a single proxy.
TRUST_PROXY=0
# AI engine: mock (default, no network, no key) or gemini. Gemini is never enabled by default.
AI_PROVIDER=mock
# Required only when AI_PROVIDER=gemini. Never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Generations + style-notes suggestions each teacher may request per UTC day
AI_DAILY_LIMIT_PER_TEACHER=20
# AI calls (personal lessons, quizzes, tutor replies) each student may make per UTC day
AI_DAILY_LIMIT_PER_STUDENT=30
# Shared secret a teacher must provide to register, at least 8 characters (required)
TEACHER_SECRET=change-me-teacher-secret
